# Copy to .env for local development. Keep the actual API key outside this repo.
MONITOR_SOURCE=fixtures
TYPESAFE_MODE=heuristic
TYPESAFE_API_KEY_FILE=/run/secrets/typesafe_api_key
SUPERSET_URL=http://superset:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
MONITOR_STORE=/app/data/monitors.json
# Set in a deployment to protect MCP and webhook HTTP traffic. Keep blank for a localhost-only demo.
SIGNALWEAVE_API_TOKEN=
PUSH_WEBHOOK_TOKEN=
