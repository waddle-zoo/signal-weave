# Copy to .env for local development. Keep the actual API key outside this repo.
# The product path always uses Jev. Point this at a local file before `docker compose up`.
TYPESAFE_MODE=jev
TYPESAFE_API_KEY_FILE=./secrets/typesafe_api_key
TYPESAFE_TIMEOUT_SECONDS=30
SUPERSET_URL=http://superset:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
SIGNALWEAVE_STORE_BACKEND=sqlite
SIGNALWEAVE_STORE_PATH=/app/data/signalweave.db
# Optional tenant-aware Trino catalog and read-only executor.
SIGNALWEAVE_TENANT_ID=
SIGNALWEAVE_PRINCIPAL_ID=
TRINO_URL=
TRINO_USER=signal-weave
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_CATALOG_FILE=
TRINO_MAX_ROWS=1000
# The compose file defaults both to local-dev-token for loopback-only development.
# Replace these with deployment secrets before sharing the service.
SIGNALWEAVE_API_TOKEN=local-dev-token
PUSH_WEBHOOK_TOKEN=local-dev-token
# Shared deployments: use the built-in signed OIDC resource-server path instead
# of the single-tenant static token above.
SIGNALWEAVE_AUTH_MODE=token
SIGNALWEAVE_OIDC_ISSUER_URL=
SIGNALWEAVE_OIDC_AUDIENCE=signalweave
SIGNALWEAVE_OIDC_JWKS_URL=
SIGNALWEAVE_OIDC_TENANT_CLAIM=tenant_id
SIGNALWEAVE_OIDC_PRINCIPAL_CLAIM=sub
SIGNALWEAVE_OIDC_REQUIRED_SCOPES=
