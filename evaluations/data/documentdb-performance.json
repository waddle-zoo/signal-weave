        "key": "cloudwatch-performance",
        "adapter": "cloudwatch",
        "resource": "metric-group:docdb-performance",
        "label": "DocumentDB customer performance metrics",
        "required": true
      }
    ],
    "comparison_windows": ["previous_period", "same_period_previous_day"],
    "action_confidence_threshold": 0.7,
    "owner": "documentdb-demo-owner",
