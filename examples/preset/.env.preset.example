# Copy to .env.preset and keep the copy untracked.
# Preset API credentials should be read-only and limited to the workspace.
PRESET_URL=https://your-workspace.<region>.app.preset.io
PRESET_WORKSPACE=your-workspace
PRESET_TENANT_ID=your-company
PRESET_API_TOKEN_NAME=replace-me
PRESET_API_TOKEN_SECRET=replace-me
# For a deployment, leave the two direct values empty and use
# docker-compose.preset.secrets.yml with host-only:
# PRESET_API_TOKEN_NAME_HOST_FILE=/absolute/path/preset-token-name
# PRESET_API_TOKEN_SECRET_HOST_FILE=/absolute/path/preset-token-secret
PRESET_DATA_MODE=cached_results
PRESET_ALLOW_LIVE_QUERIES=false
PRESET_ALLOW_REFRESH=false
PRESET_MAX_RESULT_ROWS=500
PRESET_MAX_SNAPSHOT_BYTES=1000000

# SignalWeave's loopback auth for the first local run. Put this behind your
# existing identity-aware proxy before exposing it to other users.
SIGNALWEAVE_AUTH_MODE=token
SIGNALWEAVE_TENANT_ID=your-company
SIGNALWEAVE_PRINCIPAL_ID=signalweave-agent
SIGNALWEAVE_API_TOKEN=replace-me
PUSH_WEBHOOK_TOKEN=replace-me
