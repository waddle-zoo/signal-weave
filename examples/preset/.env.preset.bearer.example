# Copy to .env.preset and keep the copy untracked.
# Use with docker-compose.preset.bearer.secrets.yml and a short-lived,
# read-only Preset workspace bearer token supplied through a host secret file.
PRESET_URL=https://your-workspace.<region>.app.preset.io
PRESET_WORKSPACE=your-workspace
PRESET_TENANT_ID=your-company
PRESET_ACCESS_TOKEN=replace-me
PRESET_DATA_MODE=cached_results
PRESET_ALLOW_LIVE_QUERIES=false
PRESET_ALLOW_REFRESH=false
PRESET_MAX_RESULT_ROWS=500
PRESET_MAX_SNAPSHOT_BYTES=1000000

SIGNALWEAVE_AUTH_MODE=token
SIGNALWEAVE_TENANT_ID=your-company
SIGNALWEAVE_PRINCIPAL_ID=signalweave-agent
SIGNALWEAVE_API_TOKEN=replace-me
PUSH_WEBHOOK_TOKEN=replace-me
